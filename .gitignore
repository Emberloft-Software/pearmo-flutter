# Auto-regenerated by `flutter pub get` from pubspec.yaml plugins — tracking
# these just creates line-ending/ordering diff noise across contributors'
# machines and OSes.
**/linux/flutter/generated_plugin_registrant.cc
**/linux/flutter/generated_plugin_registrant.h
**/linux/flutter/generated_plugins.cmake
**/macos/Flutter/GeneratedPluginRegistrant.swift
**/windows/flutter/generated_plugin_registrant.cc
**/windows/flutter/generated_plugin_registrant.h
**/windows/flutter/generated_plugins.cmake

# Local design/reference docs, not part of the app
/documents/

# Generated avatar notification icons — 8.5MB of output that
# tools/build_avatar_icons.py recreates from assets/avatars/ in one command.
# They live in the public `avatar-icons` Storage bucket, not in the repo.
/tools/avatar-icons-out/
__pycache__/